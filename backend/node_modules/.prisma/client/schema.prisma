generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

model Project {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  idea      String
  audience  String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyses Analysis[]
}

model Analysis {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  score     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports     Report[]
  competitors Competitor[]
  agentLogs   AgentLog[]
}

model Report {
  id         String   @id @default(uuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id])
  content    Json // The generated final report data
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Competitor {
  id         String   @id @default(uuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id])
  name       String
  strengths  String[]
  weaknesses String[]
  createdAt  DateTime @default(now())
}

model AgentLog {
  id          String   @id @default(uuid())
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id])
  agentName   String
  input       Json
  output      Json?
  status      String   @default("STARTED") // STARTED, COMPLETED, FAILED
  executionMs Int?
  createdAt   DateTime @default(now())
}
