DATABASE_URL="postgresql://username:password@localhost:5432/startup_platform?schema=public"
JWT_SECRET="generate_a_real_secret_with: node -e console.log(require('crypto').randomBytes(64).toString('hex'))"
PORT=5000
CORS_ORIGIN="http://localhost:5173"

# AI API Keys
GOOGLE_API_KEY="your_google_gemini_api_key"
TAVILY_API_KEY="your_tavily_api_key_optional"

# Redis (Optional — app works without it, caching is just disabled)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
